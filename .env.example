# Copy this file to .env and fill in your details
# .env is NOT committed to git (it contains passwords)

# Your Gmail address
GMAIL_USER=yourname@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# How to get one:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Search for "App passwords" and create one for "Mail"
#   4. Paste the 16-character password below (no spaces)
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional: change the web server secret key
SECRET_KEY=change-me-to-something-random

# HubSpot Private App Token (for Legal Dashboard on port 5001)
# How to get one:
#   1. In HubSpot, go to Settings → Integrations → Private Apps
#   2. Create a new private app
#   3. Grant scopes: crm.objects.contacts.read  crm.objects.deals.read
#   4. Copy the token and paste it below
HUBSPOT_TOKEN=your_hubspot_private_app_token
